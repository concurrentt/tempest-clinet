{
  // Cloudflare Workers config for the Tempest online service.
  "name": "tempest-backend",
  "main": "src/index.js",
  "compatibility_date": "2025-09-01",
  "workers_dev": true,
  "preview_urls": false,
  "durable_objects": {
    "bindings": [{ "name": "PRESENCE", "class_name": "Presence" }]
  },
  // The free plan only allows SQLite-backed Durable Objects (this one never writes to storage anyway).
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Presence"] }]
}
